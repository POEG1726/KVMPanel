{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "panel.schema.json",
  "title": "KVMPanel panel socket (kvmd <-> panel), one JSON object per line",
  "$defs": {
    "ToPanel": {
      "oneOf": [
        { "$ref": "#/$defs/Hello" },
        { "$ref": "#/$defs/Telemetry" },
        { "$ref": "#/$defs/Pc" },
        { "$ref": "#/$defs/Status" },
        { "$ref": "#/$defs/Board" },
        { "$ref": "#/$defs/Config" },
        { "$ref": "#/$defs/KvmRestarting" },
        { "$ref": "#/$defs/Result" }
      ]
    },
    "FromPanel": {
      "oneOf": [
        { "$ref": "#/$defs/GetConfig" },
        { "$ref": "#/$defs/PatchConfig" },
        { "$ref": "#/$defs/Action" },
        { "$ref": "#/$defs/DeviceInfoRequest" }
      ]
    },
    "Id": { "type": "integer", "minimum": 0 },
    "Metric": {
      "type": "object",
      "required": ["id", "label", "unit", "value", "min", "max", "group"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "value": { "type": ["number", "null"], "description": "null when the PC does not report it (e.g. empty DIMM slot)" },
        "min": { "type": "number", "description": "Fixed sparkline range" },
        "max": { "type": "number" },
        "warn": { "type": "number", "description": "Flash red above this; already merged with config.panel.thresholds" },
        "group": { "enum": ["cpu", "gpu", "mem", "sys"] }
      }
    },
    "Hello": {
      "type": "object", "required": ["t", "version"], "additionalProperties": false,
      "properties": { "t": { "const": "hello" }, "version": { "type": "string" } }
    },
    "Telemetry": {
      "description": "Once per second while the PC host program is connected",
      "type": "object", "required": ["t", "ts", "metrics"], "additionalProperties": false,
      "properties": {
        "t": { "const": "telemetry" },
        "ts": { "type": "integer", "description": "Unix ms" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/Metric" } }
      }
    },
    "Pc": {
      "description": "Host program connection change; telemetry stops while connected=false",
      "type": "object", "required": ["t", "connected", "last_seen_ts"], "additionalProperties": false,
      "properties": {
        "t": { "const": "pc" },
        "connected": { "type": "boolean" },
        "last_seen_ts": { "type": ["integer", "null"] }
      }
    },
    "Status": {
      "description": "On change and every 5 s; drives the top-right status chips",
      "type": "object", "required": ["t", "eth", "pc", "usb_a", "kvm", "lux"], "additionalProperties": false,
      "properties": {
        "t": { "const": "status" },
        "eth": {
          "type": "object", "required": ["state", "mbps", "ip"], "additionalProperties": false,
          "properties": {
            "state": { "enum": ["up", "no_ip", "down"] },
            "mbps": { "type": "integer", "minimum": 0 },
            "ip": { "type": ["string", "null"] }
          }
        },
        "pc": {
          "type": "object", "required": ["state"], "additionalProperties": false,
          "properties": { "state": { "enum": ["ok", "partial", "off"], "description": "ok: HID + host program; partial: one of them; off: USB-C not connected" } }
        },
        "usb_a": {
          "type": "object", "required": ["device"], "additionalProperties": false,
          "properties": { "device": { "type": ["string", "null"] } }
        },
        "kvm": {
          "type": "object", "required": ["enabled", "sessions"], "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "sessions": { "type": "integer", "minimum": 0 } }
        },
        "lux": { "type": ["number", "null"] }
      }
    },
    "Usage": {
      "type": "object", "required": ["used", "total"], "additionalProperties": false,
      "properties": { "used": { "type": "number", "minimum": 0, "description": "Bytes" }, "total": { "type": "number", "minimum": 0, "description": "Bytes" } }
    },
    "Board": {
      "description": "KVMPanel's own state, once per second whether or not the PC is connected; drives the PC-offline page",
      "type": "object",
      "required": ["t", "ts", "pc_power", "hostname", "version", "uptime_s", "cpu_pct", "soc_temp_c", "mem", "sd", "eth", "access", "kvm"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "board" },
        "ts": { "type": "integer", "description": "Unix ms" },
        "pc_power": { "enum": ["on", "off", "unknown"], "description": "PC power LED input (PE12); unknown when it cannot be read" },
        "hostname": { "type": "string" },
        "version": { "type": "string", "description": "KVMPanel software version" },
        "uptime_s": { "type": "integer", "minimum": 0 },
        "cpu_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "Board CPU load over both cores" },
        "soc_temp_c": { "type": ["number", "null"] },
        "mem": { "$ref": "#/$defs/Usage" },
        "sd": { "oneOf": [{ "$ref": "#/$defs/Usage" }, { "type": "null" }], "description": "SD card data partition; null without a card" },
        "eth": {
          "type": "object", "required": ["iface", "link_mbps", "duplex", "mac", "rx_bps", "tx_bps"], "additionalProperties": false,
          "properties": {
            "iface": { "type": "string" },
            "link_mbps": { "type": "integer", "minimum": 0, "description": "0 while the link is down" },
            "duplex": { "enum": ["full", "half", null] },
            "mac": { "type": "string" },
            "rx_bps": { "type": "number", "minimum": 0, "description": "Bits per second received by the board itself" },
            "tx_bps": { "type": "number", "minimum": 0, "description": "Bits per second sent by the board itself" }
          }
        },
        "access": {
          "type": "object", "required": ["url", "tailscale_ip"], "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "description": "e.g. https://kvmpanel.local (http:// while HTTPS is off)" },
            "tailscale_ip": { "type": ["string", "null"], "description": "null while Tailscale is not running" }
          }
        },
        "kvm": {
          "type": "object", "required": ["sessions", "hdmi", "stream", "media", "usb_functions"], "additionalProperties": false,
          "properties": {
            "sessions": {
              "description": "Open remote console sessions",
              "type": "array",
              "items": { "type": "object", "required": ["user", "ip"], "additionalProperties": false, "properties": { "user": { "type": "string" }, "ip": { "type": "string" } } }
            },
            "hdmi": {
              "type": "object", "required": ["signal", "width", "height", "fps"], "additionalProperties": false,
              "properties": { "signal": { "type": "boolean" }, "width": { "type": ["integer", "null"] }, "height": { "type": ["integer", "null"] }, "fps": { "type": ["number", "null"] } }
            },
            "stream": {
              "type": "object", "required": ["state", "fps"], "additionalProperties": false,
              "properties": { "state": { "enum": ["idle", "streaming"] }, "fps": { "type": ["number", "null"], "description": "null while idle" } }
            },
            "media": {
              "type": "object", "required": ["mounted", "mode"], "additionalProperties": false,
              "properties": { "mounted": { "type": ["string", "null"], "description": "Image file name" }, "mode": { "enum": ["cdrom", "disk", null] } }
            },
            "usb_functions": {
              "description": "Gadget functions running now (the applied set, not pending config)",
              "type": "array",
              "items": { "enum": ["keyboard", "mouse_rel", "mouse_abs", "storage", "net", "acm", "telemetry"] }
            }
          }
        }
      }
    },
    "Config": {
      "description": "Whole Config (openapi.yaml components/schemas/Config) on connect and after every change",
      "type": "object", "required": ["t", "config"], "additionalProperties": false,
      "properties": { "t": { "const": "config" }, "config": { "type": "object" } }
    },
    "KvmRestarting": {
      "type": "object", "required": ["t"], "additionalProperties": false,
      "properties": { "t": { "const": "kvm_restarting" } }
    },
    "Result": {
      "description": "Reply to a request with the same id. id is absent when the request line could not be parsed.",
      "type": "object", "required": ["t", "ok"], "additionalProperties": false,
      "properties": {
        "t": { "const": "result" },
        "id": { "$ref": "#/$defs/Id" },
        "ok": { "type": "boolean" },
        "data": {},
        "error": { "type": "string" },
        "detail": { "type": "object" }
      }
    },
    "GetConfig": {
      "type": "object", "required": ["t", "id"], "additionalProperties": false,
      "properties": { "t": { "const": "get_config" }, "id": { "$ref": "#/$defs/Id" } }
    },
    "PatchConfig": {
      "type": "object", "required": ["t", "id", "patch"], "additionalProperties": false,
      "properties": { "t": { "const": "patch_config" }, "id": { "$ref": "#/$defs/Id" }, "patch": { "type": "object" } }
    },
    "Action": {
      "description": "pc_power_on is a short press of the PC power button (PE13). It is refused with error pc_on while the power LED is lit, so the panel can never switch the PC off.",
      "type": "object", "required": ["t", "id", "action"], "additionalProperties": false,
      "properties": {
        "t": { "const": "action" },
        "id": { "$ref": "#/$defs/Id" },
        "action": { "enum": ["reboot", "shutdown", "restart_kvm", "reset_hid", "disconnect_sessions", "eject_media", "usb_apply", "pc_power_on"] }
      }
    },
    "DeviceInfoRequest": {
      "type": "object", "required": ["t", "id"], "additionalProperties": false,
      "properties": { "t": { "const": "device_info" }, "id": { "$ref": "#/$defs/Id" } }
    }
  }
}
