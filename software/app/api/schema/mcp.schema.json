{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KVMPanel MCP tool schemas",
  "tools": {
    "screenshot": {
      "description": "Capture a JPEG of the current HDMI screen.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "max_width": {
            "type": "integer",
            "minimum": 320,
            "maximum": 65535,
            "default": 1280
          },
          "quality": {
            "type": "integer",
            "minimum": 40,
            "maximum": 90,
            "default": 70
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0
              },
              "source_width": {
                "type": "integer",
                "minimum": 0
              },
              "source_height": {
                "type": "integer",
                "minimum": 0
              },
              "region": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "width",
              "height",
              "source_width",
              "source_height",
              "region",
              "size"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "screen_wait": {
      "description": "Wait for a screen change or for the screen to stabilize.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "until": {
            "type": "string",
            "enum": [
              "changed",
              "stable"
            ]
          },
          "region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "stable_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000,
            "default": 1500
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000,
            "default": 30000
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.005
          }
        },
        "required": [
          "until"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "met": {
                "type": "boolean"
              },
              "waited_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "met",
              "waited_ms"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "screen_history": {
      "description": "Read recent HDMI frames and their timestamps.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 30
          },
          "max_frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 8
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ts": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "ts"
                  ],
                  "additionalProperties": true
                },
                "maxItems": 8
              }
            },
            "required": [
              "frames"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "host_status": {
      "description": "Inspect power, screen, USB, telemetry and remote-control status.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "power": {
                "type": "object"
              },
              "video": {
                "type": "object"
              },
              "keyboard": {
                "type": "object"
              },
              "usb": {
                "type": "object"
              },
              "telemetry": {
                "type": "object"
              },
              "host_agent": {
                "type": "object"
              },
              "media": {
                "type": "object"
              },
              "control": {
                "type": "object"
              }
            },
            "required": [
              "power",
              "video",
              "keyboard",
              "usb",
              "telemetry",
              "host_agent",
              "media",
              "control"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "telemetry_read": {
      "description": "Read current PC metrics.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 768
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [],
        "additionalProperties": false,
        "allOf": [
          {
            "not": {
              "required": [
                "ids",
                "groups"
              ]
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "group": {
                      "type": "string"
                    },
                    "warn": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "unit",
                    "value",
                    "group",
                    "warn"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "metrics"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "telemetry_watch": {
      "description": "Summarize metrics received during a timed interval.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 768
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [
          "seconds"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "not": {
              "required": [
                "ids",
                "groups"
              ]
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "min": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "max": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "avg": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "last": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "samples": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "nulls": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "over_warn": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "min",
                    "max",
                    "avg",
                    "last",
                    "samples",
                    "nulls",
                    "over_warn"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "metrics"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "telemetry_catalogue": {
      "description": "List known metrics and their units and ranges.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "unit",
                    "group",
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "metrics"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "host_info": {
      "description": "Inspect the Windows foreground window, displays, cursor and local session.",
      "scope": "observe",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "foreground": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "cursor": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "displays": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "session": {
                "type": "string",
                "enum": [
                  "unlocked",
                  "locked",
                  "secure_desktop",
                  "screensaver"
                ]
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "foreground",
              "cursor",
              "displays",
              "session"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    "type_text": {
      "description": "Type text using the configured keyboard layout.",
      "scope": "input",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    "press_keys": {
      "description": "Press one to eight KeyboardEvent.code keys with at most six non-modifiers.",
      "scope": "input",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "hold_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 50
          }
        },
        "required": [
          "keys"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    "move_mouse": {
      "description": "Move to absolute coordinates or by relative pixels.",
      "scope": "input",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "absolute",
              "relative"
            ],
            "default": "absolute"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "dx": {
            "type": "integer",
            "minimum": -65535,
            "maximum": 65535
          },
          "dy": {
            "type": "integer",
            "minimum": -65535,
            "maximum": 65535
          }
        },
        "required": [],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "relative"
                }
              }
            },
            "then": {
              "required": [
                "dx",
                "dy"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "x"
                    ]
                  },
                  {
                    "required": [
                      "y"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "x",
                "y"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "dx"
                    ]
                  },
                  {
                    "required": [
                      "dy"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    "click_mouse": {
      "description": "Click the selected mouse button, optionally after moving.",
      "scope": "input",
      "inputSchema": {
        "type": "object",
        "properties": {
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "clicks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "button"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "x"
              ]
            },
            "then": {
              "required": [
                "y"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "y"
                ]
              }
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    "drag_mouse": {
      "description": "Drag a button between two absolute points.",
      "scope": "input",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 20
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "default": 300
          },
          "from": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "from",
          "to",
          "button"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": true
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    "scroll_mouse": {
      "description": "Scroll a signed number of notches; positive scrolls down.",
      "scope": "input",
      "inputSchema": {
