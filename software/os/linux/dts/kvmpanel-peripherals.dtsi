#include <dt-bindings/leds/common.h>
#include <dt-bindings/reset/sun20i-d1-ccu.h>

/ {
	soc {
		led-controller@2008000 {
			compatible = "allwinner,sun20i-d1-ledc", "allwinner,sun50i-a100-ledc";
			reg = <0x2008000 0x400>;
			interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_LEDC>, <&ccu CLK_LEDC>;
			clock-names = "bus", "mod";
			resets = <&ccu RST_BUS_LEDC>;
			assigned-clocks = <&ccu CLK_LEDC>;
			assigned-clock-parents = <&dcxo>;
			assigned-clock-rates = <24000000>;
			pinctrl-names = "default";
			pinctrl-0 = <&ledc_pg13_pin>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* Four pixels fit in the FIFO. The timing registers encode cycles - 1. */
			allwinner,pixel-format = "grb";
			allwinner,t0h-ns = <300>;
			allwinner,t0l-ns = <935>;
			allwinner,t1h-ns = <620>;
			allwinner,t1l-ns = <620>;
			allwinner,treset-ns = <310000>;

			/* Daisy chain order: LED1, LED2, LED4, LED5. */
			multi-led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_RGB>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <1>;
			};

			multi-led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_RGB>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <2>;
			};

			multi-led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_RGB>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <3>;
			};

			multi-led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_RGB>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <4>;
			};
		};

		ths: thermal-sensor@2009400 {
			compatible = "allwinner,sun20i-d1-ths";
			reg = <0x2009400 0x400>;
			interrupts = <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_THS>;
			clock-names = "bus";
			resets = <&ccu RST_BUS_THS>;
			nvmem-cells = <&ths_calibration>;
			nvmem-cell-names = "calibration";
			#thermal-sensor-cells = <0>;
		};
	};

	thermal-zones {
		cpu-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths>;

			trips {
				cpu-critical {
					temperature = <100000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};
	};
};

&dcxo {
	clock-frequency = <24000000>;
};

&sid {
	ths_calibration: thermal-sensor-calibration@14 {
		reg = <0x14 0x8>;
	};
};

&pio {
	/* F4 feeds the 1.8 V leg. The other leg uses SoC VCC-IO. */
	vcc-pf-supply = <&reg_1v8>;

	ledc_pg13_pin: ledc-pg13-pin {
		pins = "PG13";
		function = "ledc";
		bias-disable;
	};

	reg_pf_io: pf-vqmmc {
		regulator-name = "PF-SD-IO";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
	};

	sd_data_cmd_pins: sd-data-cmd-pins {
		pins = "PF0", "PF1", "PF3", "PF4", "PF5";
		function = "mmc0";
		bias-pull-up;
	};

	sd_clk_pin: sd-clk-pin {
		pins = "PF2";
		function = "mmc0";
		bias-disable;
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pd_pins>;
	clock-frequency = <100000>;
	status = "okay";

	light-sensor@23 {
		compatible = "rohm,bh1750";
		/* U6.2 (ADDR) is grounded. */
		reg = <0x23>;
	};

	touchscreen@20 {
		compatible = "syna,rmi4-i2c";
		reg = <0x20>;
		vdd-supply = <&reg_3v3_main>;
		vio-supply = <&reg_1v8>;
		#address-cells = <1>;
		#size-cells = <0>;
		/* CN2.35 (IRQ) and CN2.5 (reset) reach PD14 and PD19. */
		status = "disabled";

		rmi4-f12@12 {
			reg = <0x12>;
			syna,sensor-type = <1>;
		};
	};
};

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&sd_data_cmd_pins>, <&sd_clk_pin>;
	bus-width = <4>;
	max-frequency = <150000000>;
	vmmc-supply = <&reg_3v3_main>;
	vqmmc-supply = <&reg_pf_io>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	no-mmc;
	no-sdio;
	disable-wp;
	/* Poll the removable card until the PF6 CD polarity is confirmed. */
	broken-cd;
	status = "okay";
};

/* Use with the ARMv7 FEL build; keep reserved if firmware owns the watchdog. */
&wdt {
	status = "okay";
};
