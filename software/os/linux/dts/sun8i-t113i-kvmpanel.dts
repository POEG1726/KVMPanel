/dts-v1/;

#include <dt-bindings/clock/sun20i-d1-ccu.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "sun8i-t113s.dtsi"
#include "kvmpanel-stc-power.dtsi"

/ {
	model = "KVMPanel T113-i";
	compatible = "kvmpanel,t113-i", "allwinner,sun8i-t113s";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* Nominal capacity of the single K4B4G1646D-BCK0 on the PCB. */
	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x20000000>;
	};

	reg_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	reg_3v3_main: regulator-3v3-main {
		compatible = "regulator-fixed";
		regulator-name = "3V3_MAIN";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_5v: regulator-5v {
		compatible = "regulator-fixed";
		regulator-name = "5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
};

&ehci1 {
	status = "okay";
};

&emac {
	pinctrl-0 = <&rgmii_pg_pins>;
	pinctrl-names = "default";
	phy-handle = <&rtl8211f>;
	phy-mode = "rgmii-id";
	phy-supply = <&reg_3v3_main>;
	status = "okay";
};

&mdio {
	rtl8211f: ethernet-phy@1 {
		compatible = "ethernet-phy-id001c.c916", "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		/* The PHY uses its own 25 MHz crystal. */
		reset-gpios = <&pio 2 1 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		/* Allow crystal startup, 1 V rise and PHY settle time before MDIO. */
		reset-deassert-us = <200000>;
		interrupts-extended = <&pio 2 7 IRQ_TYPE_LEVEL_LOW>;
	};
};

&ohci1 {
	status = "okay";
};

&pio {
	vcc-pb-supply = <&reg_3v3_main>;
	vcc-pc-supply = <&reg_3v3_main>;
	vcc-pg-supply = <&reg_3v3_main>;

	rgmii_pg_pins: rgmii-pg-pins {
		pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5", "PG6",
		       "PG7", "PG8", "PG9", "PG10", "PG12", "PG14", "PG15";
		function = "emac";
	};

	/* UART0 is routed to U11 (CH343K) on the USB2 debug connector. */
	uart0_pb8_pins: uart0-pb8-pins {
		pins = "PB8", "PB9";
		function = "uart0";
	};
};

&uart0 {
	pinctrl-0 = <&uart0_pb8_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	usb1_vbus-supply = <&reg_5v>;
	status = "okay";
};
