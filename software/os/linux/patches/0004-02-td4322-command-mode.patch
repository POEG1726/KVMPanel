diff --git a/drivers/gpu/drm/panel/panel-td4322.c b/drivers/gpu/drm/panel/panel-td4322.c
new file mode 100644
index 000000000..80a10af39
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-td4322.c
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * panel-td4322.c
+ * Created on Nov 20, 2026
+ * Author: @POEG1726
+ *
+ * Mode and panel command sequence from the supplier's GPL TD4322 profile.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <video/mipi_display.h>
+
+struct td4322_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset;
+	/* Protect brightness writes while changing the panel power state. */
+	struct mutex lock;
+	bool ready;
+};
+
+static inline struct td4322_panel *to_td4322_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct td4322_panel, panel);
+}
+
+static int td4322_panel_on(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf3, 0x01, 0x00);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_EXIT_SLEEP_MODE, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xcc, 0x54, 0x8a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb0, 0x04);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb6, 0x13);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_TEAR_ON, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x57, 0x40);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd2, 0x20);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_ON, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int td4322_panel_prepare(struct drm_panel *panel)
+{
+	struct td4322_panel *ctx = to_td4322_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	guard(mutex)(&ctx->lock);
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return ret;
+
+	/* The module controls VAVDD/ELVDD/ELVSS through the bias converter. */
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(120);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(120);
+
+	ret = td4322_panel_on(ctx->dsi);
+	if (!ret) {
+		/* Each TE launches a full RGB888 frame into this address window. */
+		mipi_dsi_dcs_set_pixel_format_multi(&dsi_ctx, MIPI_DCS_PIXEL_FMT_24BIT);
+		mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0, 1079);
+		mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0, 1919);
+		ret = dsi_ctx.accum_err;
+	}
+	if (ret) {
+		dev_err(panel->dev, "panel initialization failed: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return ret;
+	}
+
+	ctx->ready = true;
+	return 0;
+}
+
+static int td4322_panel_unprepare(struct drm_panel *panel)
+{
+	struct td4322_panel *ctx = to_td4322_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	guard(mutex)(&ctx->lock);
+	ctx->ready = false;
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	msleep(150);
+	if (dsi_ctx.accum_err)
+		dev_warn(panel->dev, "sleep sequence failed: %d\n", dsi_ctx.accum_err);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(10000, 11000);
+
+	return regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+}
+
+static const struct drm_display_mode td4322_panel_mode = {
+	.clock = 140640,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 140,
+	.hsync_end = 1080 + 140 + 12,
+	.htotal = 1080 + 140 + 12 + 70,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 16,
+	.vsync_end = 1920 + 16 + 5,
+	.vtotal = 1920 + 16 + 5 + 16,
+	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	.width_mm = 68,
+	.height_mm = 121,
+};
+
+static int td4322_panel_get_modes(struct drm_panel *panel,
+				  struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &td4322_panel_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs td4322_funcs = {
+	.prepare = td4322_panel_prepare,
+	.unprepare = td4322_panel_unprepare,
+	.get_modes = td4322_panel_get_modes,
+};
+
+static int td4322_update_brightness(struct backlight_device *bl)
+{
+	struct td4322_panel *ctx = bl_get_data(bl);
+	u8 brightness = backlight_get_brightness(bl);
+	ssize_t ret;
+
+	guard(mutex)(&ctx->lock);
+	if (!ctx->ready)
+		return 0;
+
+	ret = mipi_dsi_dcs_write(ctx->dsi, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				 &brightness, sizeof(brightness));
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops td4322_bl_ops = {
+	.update_status = td4322_update_brightness,
+};
+
+static int td4322_probe(struct mipi_dsi_device *dsi)
+{
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 184,
+		.max_brightness = 255,
+	};
+	struct device *dev = &dsi->dev;
+	struct td4322_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct td4322_panel, panel,
+				   &td4322_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supplies[0].supply = "vci";
+	ctx->supplies[1].supply = "vddi";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get panel supplies\n");
+
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "failed to get panel reset\n");
+
+	ret = devm_mutex_init(dev, &ctx->lock);
+	if (ret)
+		return ret;
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_LPM;
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+							      dev, ctx, &td4322_bl_ops,
+							      &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return PTR_ERR(ctx->panel.backlight);
+
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret)
+		drm_panel_remove(&ctx->panel);
+
+	return ret;
+}
+
+static void td4322_remove(struct mipi_dsi_device *dsi)
+{
+	struct td4322_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id td4322_of_match[] = {
+	{ .compatible = "synaptics,td4322" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, td4322_of_match);
+
+static struct mipi_dsi_driver td4322_driver = {
+	.probe = td4322_probe,
+	.remove = td4322_remove,
+	.driver = {
+		.name = "panel-td4322",
+		.of_match_table = td4322_of_match,
+	},
+};
+module_mipi_dsi_driver(td4322_driver);
+
+MODULE_DESCRIPTION("Synaptics TD4322 command mode panel");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.c b/drivers/gpu/drm/sun4i/sun4i_tcon.c
index 67047e3b6..26f7c070a 100644
