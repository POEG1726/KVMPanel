@@ -234,7 +234,7 @@ void sun4i_tcon_enable_vblank(struct sun4i_tcon *tcon, bool enable)
 		SUN4I_TCON_GINT0_TCON0_TRI_FINISH_ENABLE;
 
 	if (enable)
-		val = mask;
+		val = tcon->command_mode ? SUN4I_TCON_GINT0_TCON0_TRI_FINISH_ENABLE : mask;
 
 	regmap_update_bits(tcon->regs, SUN4I_TCON_GINT0_REG, mask, val);
 }
@@ -353,15 +353,13 @@ static void sun4i_tcon0_mode_set_cpu(struct sun4i_tcon *tcon,
 	u8 bpp = mipi_dsi_pixel_format_to_bpp(device->format);
 	u8 lanes = device->lanes;
 	u32 block_space, start_delay;
-	u32 tcon_div;
+	u32 tcon_div, trans_start = 10;
 
-	/*
-	 * dclk is required to run at 1/4 the DSI per-lane bit rate.
-	 */
-	tcon->dclk_min_div = SUN6I_DSI_TCON_DIV;
-	tcon->dclk_max_div = SUN6I_DSI_TCON_DIV;
-	clk_set_rate(tcon->dclk, mode->crtc_clock * 1000 * (bpp / lanes)
-						  / SUN6I_DSI_TCON_DIV);
+	/* Command mode consumes one pixel per TCON clock. */
+	tcon_div = tcon->command_mode ? bpp / lanes : SUN6I_DSI_TCON_DIV;
+	tcon->dclk_min_div = tcon_div;
+	tcon->dclk_max_div = tcon_div;
+	clk_set_rate(tcon->dclk, mode->crtc_clock * 1000 * (bpp / lanes) / tcon_div);
 
 	/* Set the resolution */
 	regmap_write(tcon->regs, SUN4I_TCON0_BASIC0_REG,
@@ -390,10 +388,15 @@ static void sun4i_tcon0_mode_set_cpu(struct sun4i_tcon *tcon,
 	 * The datasheet says that this should be set higher than 20 *
 	 * pixel cycle, but it's not clear what a pixel cycle is.
 	 */
-	regmap_read(tcon->regs, SUN4I_TCON0_DCLK_REG, &tcon_div);
-	tcon_div &= GENMASK(6, 0);
-	block_space = mode->htotal * bpp / (tcon_div * lanes);
-	block_space -= mode->hdisplay + 40;
+	if (tcon->command_mode) {
+		block_space = mode->htotal - mode->hdisplay;
+		trans_start = mode->hdisplay - 1;
+	} else {
+		regmap_read(tcon->regs, SUN4I_TCON0_DCLK_REG, &tcon_div);
+		tcon_div &= GENMASK(6, 0);
+		block_space = mode->htotal * bpp / (tcon_div * lanes);
+		block_space -= mode->hdisplay + 40;
+	}
 
 	regmap_write(tcon->regs, SUN4I_TCON0_CPU_TRI0_REG,
 		     SUN4I_TCON0_CPU_TRI0_BLOCK_SPACE(block_space) |
@@ -406,7 +409,7 @@ static void sun4i_tcon0_mode_set_cpu(struct sun4i_tcon *tcon,
 	start_delay = start_delay * mode->crtc_htotal * 149;
 	start_delay = start_delay / (mode->crtc_clock / 1000) / 8;
 	regmap_write(tcon->regs, SUN4I_TCON0_CPU_TRI2_REG,
-		     SUN4I_TCON0_CPU_TRI2_TRANS_START_SET(10) |
+		     SUN4I_TCON0_CPU_TRI2_TRANS_START_SET(trans_start) |
 		     SUN4I_TCON0_CPU_TRI2_START_DELAY(start_delay));
 
 	/*
@@ -713,6 +716,8 @@ void sun4i_tcon_mode_set(struct sun4i_tcon *tcon,
 			 const struct drm_encoder *encoder,
 			 const struct drm_display_mode *mode)
 {
+	tcon->command_mode = encoder->encoder_type == DRM_MODE_ENCODER_DSI &&
+			     encoder_to_sun6i_dsi(encoder)->te_irq > 0;
 	switch (encoder->encoder_type) {
 	case DRM_MODE_ENCODER_DSI:
 		/* DSI is tied to special case of CPU interface */
diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.h b/drivers/gpu/drm/sun4i/sun4i_tcon.h
