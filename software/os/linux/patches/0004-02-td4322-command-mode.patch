@@ -306,12 +314,14 @@ static void sun6i_dsi_inst_commit(struct sun6i_dsi *dsi)
 
 static int sun6i_dsi_inst_wait_for_completion(struct sun6i_dsi *dsi)
 {
+	/* LP packets normally finish within 5 ms; a full frame can take longer. */
+	unsigned int timeout = dsi->refresh_tcon ? 50000 : 5000;
 	u32 val;
 
 	return regmap_read_poll_timeout(dsi->regs, SUN6I_DSI_BASIC_CTL0_REG,
 					val,
 					!(val & SUN6I_DSI_BASIC_CTL0_INST_ST),
-					100, 5000);
+					100, timeout);
 }
 
