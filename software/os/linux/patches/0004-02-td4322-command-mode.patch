+static int sun6i_dsi_get_te_irq(struct sun6i_dsi *dsi, struct device *dev)
+{
+	struct gpio_desc *te;
+	unsigned long flags;
+	int irq, ret;
+
+	te = devm_gpiod_get(dev, "te", GPIOD_IN);
+	if (IS_ERR(te))
+		return dev_err_probe(dev, PTR_ERR(te), "command mode needs a TE GPIO\n");
+	irq = gpiod_to_irq(te);
+	if (irq < 0)
+		return irq;
+	flags = gpiod_is_active_low(te) ? IRQF_TRIGGER_FALLING : IRQF_TRIGGER_RISING;
+	ret = devm_request_threaded_irq(dev, irq, NULL, sun6i_dsi_te_irq,
+					flags | IRQF_ONESHOT, "sun6i-dsi-te", dsi);
+	return ret ? ret : irq;
