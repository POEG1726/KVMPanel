@@ -459,7 +469,15 @@ static void sun6i_dsi_setup_inst_loop(struct sun6i_dsi *dsi,
 	struct mipi_dsi_device *device = dsi->device;
 	u16 delay = 50 - 1;
 
-	if (device->mode_flags & MIPI_DSI_MODE_VIDEO_BURST) {
+	if (dsi->te_irq > 0) {
+		/* NOP branches to clock exit after the last active line. */
+		regmap_write(dsi->regs, SUN6I_DSI_INST_JUMP_CFG_REG(0),
