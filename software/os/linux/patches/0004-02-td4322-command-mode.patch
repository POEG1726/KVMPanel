+static irqreturn_t sun6i_dsi_te_irq(int irq, void *data)
+{
+	struct sun6i_dsi *dsi = data;
+
+	/* Skip a busy edge rather than launching late after an LP transfer. */
+	ACQUIRE(mutex_try, lock)(&dsi->xfer_lock);
+	if (!ACQUIRE_ERR(mutex_try, &lock) && sun6i_dsi_trigger_frame(dsi))
+		mod_delayed_work(system_wq, &dsi->te_watchdog, 2 * dsi->frame_period);
+	return IRQ_HANDLED;
+}
+
+static void sun6i_dsi_te_watchdog(struct work_struct *work)
+{
+	struct sun6i_dsi *dsi = container_of(to_delayed_work(work), struct sun6i_dsi,
+					     te_watchdog);
+
+	guard(mutex)(&dsi->xfer_lock);
+	/* A good TE may already have rearmed the timer while we waited. */
+	if (!dsi->refresh_tcon || delayed_work_pending(&dsi->te_watchdog))
+		return;
+
+	sun6i_dsi_trigger_frame(dsi);
+	schedule_delayed_work(&dsi->te_watchdog, dsi->frame_period);
+}
+
+static void sun6i_dsi_stop_refresh(struct sun6i_dsi *dsi)
+{
+	scoped_guard(mutex, &dsi->xfer_lock) {
+		if (dsi->refresh_tcon && sun6i_dsi_inst_wait_for_completion(dsi)) {
+			dev_warn(dsi->dev, "timed out draining final DSI frame\n");
+			sun6i_dsi_inst_abort(dsi);
+		}
+		dsi->refresh_tcon = NULL;
+	}
+	cancel_delayed_work_sync(&dsi->te_watchdog);
+}
