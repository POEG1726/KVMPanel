+/* Insert one DCS command byte before every scanline from the TCON FIFO. */
+static void sun6i_dsi_setup_command(struct sun6i_dsi *dsi, struct drm_display_mode *mode)
+{
+	u16 wc = 1 + mode->hdisplay * 3;
+	u32 header;
+
+	header = sun6i_dsi_build_sync_pkt(MIPI_DSI_DCS_LONG_WRITE, dsi->device->channel,
+					  wc & 0xff, wc >> 8);
+	regmap_write(dsi->regs, SUN6I_DSI_BASIC_CTL1_REG, 0);
+	regmap_write(dsi->regs, SUN6I_DSI_TCON_DRQ_REG, 0);
+	regmap_write(dsi->regs, SUN6I_DSI_PIXEL_CTL0_REG, SUN6I_DSI_PIXEL_CTL0_FORMAT(0));
+	regmap_write(dsi->regs, SUN6I_DSI_PIXEL_PH_REG, header);
+	regmap_write(dsi->regs, SUN6I_DSI_PIXEL_PD_REG,
+		     FIELD_PREP(SUN6I_DSI_PIXEL_PD_LINEN, MIPI_DCS_WRITE_MEMORY_CONTINUE) |
+		     MIPI_DCS_WRITE_MEMORY_START);
+	regmap_write(dsi->regs, SUN6I_DSI_PIXEL_PF0_REG, SUN6I_DSI_PIXEL_PF0_CRC_FORCE(0xffff));
+	/* CRC-CCITT after the first payload byte, 0x2c or 0x3c respectively. */
+	regmap_write(dsi->regs, SUN6I_DSI_PIXEL_PF1_REG,
+		     SUN6I_DSI_PIXEL_PF1_CRC_INIT_LINE0(0xe4e9) |
+		     SUN6I_DSI_PIXEL_PF1_CRC_INIT_LINEN(0xf468));
