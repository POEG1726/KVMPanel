+/* A TE edge and the watchdog share one sequencer with LP commands. */
+static bool sun6i_dsi_trigger_frame(struct sun6i_dsi *dsi)
+{
+	struct sun4i_tcon *tcon = dsi->refresh_tcon;
+	u32 status;
+
+	lockdep_assert_held(&dsi->xfer_lock);
+	if (!tcon || time_before(jiffies, dsi->next_trigger))
+		return false;
+
+	if (regmap_read(tcon->regs, SUN4I_TCON0_CPU_IF_REG, &status) ||
+	    (status & SUN4I_TCON0_CPU_IF_TRI_START))
+		return false;
+	if (regmap_read(dsi->regs, SUN6I_DSI_BASIC_CTL0_REG, &status) ||
+	    (status & SUN6I_DSI_BASIC_CTL0_INST_ST))
+		return false;
+
+	/* Arm DSI before TCON. Only TRI_FINISH reports the actual vblank. */
+	sun6i_dsi_start(dsi, DSI_START_HSTX);
+	regmap_set_bits(tcon->regs, SUN4I_TCON0_CPU_IF_REG, SUN4I_TCON0_CPU_IF_TRI_START);
+	/* Discard a second edge within half a nominal frame period. */
+	dsi->next_trigger = jiffies + DIV_ROUND_UP(dsi->frame_period, 2);
+	return true;
+}
