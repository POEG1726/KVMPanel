diff --git a/drivers/media/i2c/lt8619c.c b/drivers/media/i2c/lt8619c.c
new file mode 100644
index 000000000..7101074de
--- /dev/null
+++ b/drivers/media/i2c/lt8619c.c
@@ -0,0 +1,588 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * lt8619c.c - Lontium HDMI receiver, eight-bit SDR BT.656 output
+ * Created on Nov 20, 2026
+ * Board adaptation: @POEG1726
+ * Register sequences from the GPL Rockchip driver by Dingxian Wen.
+ * Copyright (c) 2021 Rockchip Electronics Co., Ltd.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+#include <linux/v4l2-dv-timings.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-dv-timings.h>
+#include <media/v4l2-fwnode.h>
+
+#define LT_CHIP_ID		0x6000
+#define LT_RX_TIMING		0x6013
+#define LT_TX_TIMING		0x6061
+#define LT_OUTPUT		0x60a8
+#define LT_OUTPUT_OFF		0x07
+#define LT_OUTPUT_ON		0x0f
+#define LT_HPD			0x8006
+#define LT_HPD_ENABLE		BIT(3)
+#define LT_RX_SYNC		0x8013
+#define LT_TMDS_LOCK		0x8043
+#define LT_TMDS_RATE		0x8044
+#define LT_EDID_MODE		0x808e
+#define LT_EDID_ADDRESS		0x808f
+#define LT_EDID_DATA		0x8090
+#define LT_EDID_BLOCK_SIZE	128
+#define LT_MAX_BLOCKS		2
+
+struct lt8619c {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *map;
+	struct mutex lock;	/* Timings, stream state and EDID transactions */
+	struct v4l2_dv_timings timings;
+	u8 edid[LT_MAX_BLOCKS * LT_EDID_BLOCK_SIZE];
+	unsigned int blocks;
+	bool streaming;
+};
+
+static const struct regmap_range_cfg lt8619c_range = {
+	.range_min = 0,
+	.range_max = 0x80fe,
+	.selector_reg = 0xff,
+	.selector_mask = 0xff,
+	.window_start = 0,
+	.window_len = 256,
+};
+
+static const struct regmap_config lt8619c_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x80fe,
+	.ranges = &lt8619c_range,
+	.num_ranges = 1,
+};
+
+static const struct v4l2_dv_timings_cap lt8619c_cap = {
+	.type = V4L2_DV_BT_656_1120,
+	V4L2_INIT_BT_TIMINGS(320, 1920, 240, 1080, 10000000, 74250000,
+			     V4L2_DV_BT_STD_CEA861 | V4L2_DV_BT_STD_DMT,
+			     V4L2_DV_BT_CAP_PROGRESSIVE | V4L2_DV_BT_CAP_CUSTOM)
+};
+
+/*
+ * EDID 1.3: VGA established timing, 1080p30 (preferred) and 720p60 DTDs.
+ * Both DTDs use a 74.25 MHz pixel clock, or 148.5 MHz on the 8-bit bus.
+ * The range descriptor rounds the maximum pixel clock up to 10 MHz units.
+ */
+static const u8 lt8619c_default_edid[LT_EDID_BLOCK_SIZE] = {
+	0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00,
+	0x2e, 0xcd, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x01, 0x24, 0x01, 0x03, 0x80, 0x00, 0x00, 0x78,
+	0x0a, 0x0d, 0xc9, 0xa0, 0x57, 0x47, 0x98, 0x27,
+	0x12, 0x48, 0x4c, 0x20, 0x00, 0x00, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x1d,
+	0x80, 0x18, 0x71, 0x38, 0x2d, 0x40, 0x58, 0x2c,
+	0x45, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1e,
+	0x01, 0x1d, 0x00, 0x72, 0x51, 0xd0, 0x1e, 0x20,
+	0x6e, 0x28, 0x55, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x1e, 0x00, 0x00, 0x00, 0xfc, 0x00, 0x4b,
+	0x56, 0x4d, 0x50, 0x61, 0x6e, 0x65, 0x6c, 0x0a,
+	0x20, 0x20, 0x20, 0x20, 0x00, 0x00, 0x00, 0xfd,
+	0x00, 0x1e, 0x3c, 0x1f, 0x2d, 0x08, 0x00, 0x0a,
+	0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x00, 0xb2,
+};
+
+static struct lt8619c *to_lt(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct lt8619c, sd);
+}
+
+/* Leave HPD low if the sink cannot supply a complete EDID. */
+static int lt8619c_write_edid(struct lt8619c *lt, const u8 *data,
+			      unsigned int blocks)
+{
+	unsigned int i;
+	int ret;
+
+	ret = regmap_update_bits(lt->map, LT_HPD, LT_HPD_ENABLE, 0);
+	if (ret)
+		return ret;
+	lt->blocks = 0;
+	if (!blocks)
+		return 0;
+
+	/* HDMI sources require a low pulse of at least 100 ms. */
+	msleep(110);
+	ret = regmap_write(lt->map, LT_EDID_MODE, 0x07);
+	if (ret)
+		return ret;
+	ret = regmap_write(lt->map, LT_EDID_ADDRESS, 0);
+	if (ret)
+		return ret;
+	for (i = 0; i < blocks * LT_EDID_BLOCK_SIZE; i++) {
+		ret = regmap_write(lt->map, LT_EDID_DATA, data[i]);
+		if (ret)
+			return ret;
+	}
+	ret = regmap_write(lt->map, LT_EDID_MODE, 0x02);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(lt->map, LT_HPD, LT_HPD_ENABLE, LT_HPD_ENABLE);
+	if (ret)
+		return ret;
+
+	memcpy(lt->edid, data, blocks * LT_EDID_BLOCK_SIZE);
+	lt->blocks = blocks;
+	return 0;
+}
+
+static int lt8619c_get_edid(struct v4l2_subdev *sd, struct v4l2_edid *edid)
+{
+	struct lt8619c *lt = to_lt(sd);
+
+	if (edid->pad)
+		return -EINVAL;
+	guard(mutex)(&lt->lock);
+	if (!edid->start_block && !edid->blocks) {
+		edid->blocks = lt->blocks;
+		return 0;
+	}
+	if (!lt->blocks)
+		return -ENODATA;
+	if (edid->start_block >= lt->blocks || !edid->blocks)
+		return -EINVAL;
+
+	edid->blocks = min(edid->blocks, lt->blocks - edid->start_block);
+	memcpy(edid->edid, lt->edid + edid->start_block * LT_EDID_BLOCK_SIZE,
+	       edid->blocks * LT_EDID_BLOCK_SIZE);
+	return 0;
+}
+
+static int lt8619c_set_edid(struct v4l2_subdev *sd, struct v4l2_edid *edid)
+{
+	struct lt8619c *lt = to_lt(sd);
+
+	if (edid->pad || edid->start_block)
+		return -EINVAL;
+	if (edid->blocks > LT_MAX_BLOCKS) {
+		edid->blocks = LT_MAX_BLOCKS;
+		return -E2BIG;
+	}
+	guard(mutex)(&lt->lock);
+	if (lt->streaming)
+		return -EBUSY;
+	return lt8619c_write_edid(lt, edid->edid, edid->blocks);
+}
+
+/* Read a contiguous timing snapshot and reject an incomplete lock or field. */
+static int lt8619c_detect(struct lt8619c *lt, struct v4l2_dv_timings *timings)
+{
+	struct v4l2_dv_timings_cap meter_cap = lt8619c_cap;
+	struct v4l2_bt_timings *bt = &timings->bt;
+	u8 raw[17], clk[3];
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(lt->map, LT_TMDS_LOCK, &val);
+	if (ret)
+		return ret;
+	if (!(val & BIT(7)))
+		return -ENOLINK;
+	ret = regmap_read(lt->map, LT_RX_SYNC, &val);
+	if (ret)
+		return ret;
+	if (!(val & BIT(0)))
+		return -ENOLCK;
+	ret = regmap_bulk_read(lt->map, LT_RX_TIMING, raw, sizeof(raw));
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(lt->map, LT_TMDS_RATE, clk, sizeof(clk));
+	if (ret)
+		return ret;
+	ret = regmap_read(lt->map, 0x8017, &val);
+	if (ret)
+		return ret;
+
+	memset(timings, 0, sizeof(*timings));
+	timings->type = V4L2_DV_BT_656_1120;
+	bt->width = get_unaligned_be16(raw + 15);
+	bt->height = get_unaligned_be16(raw + 13) & 0xfff;
+	bt->hsync = get_unaligned_be16(raw + 1);
+	bt->hbackporch = get_unaligned_be16(raw + 5);
+	bt->hfrontporch = get_unaligned_be16(raw + 7);
+	bt->vsync = raw[0];
+	bt->vbackporch = raw[3];
+	bt->vfrontporch = raw[4];
+	bt->pixelclock = (get_unaligned_be24(clk) & 0x3ffff) * 1000;
+	if (val & BIT(7))
+		bt->polarities |= V4L2_DV_HSYNC_POS_POL;
+	if (val & BIT(6))
+		bt->polarities |= V4L2_DV_VSYNC_POS_POL;
+	if ((bt->width == 1920 && bt->height == 540) ||
+	    (bt->width == 1440 && (bt->height == 240 || bt->height == 288)))
+		return -ERANGE;
+	if (V4L2_DV_BT_FRAME_WIDTH(bt) != get_unaligned_be16(raw + 11) ||
+	    V4L2_DV_BT_FRAME_HEIGHT(bt) != (get_unaligned_be16(raw + 9) & 0xfff))
+		return -ENOLCK;
+
+	/* The frequency meter jitters. Canonicalize known modes before the limit. */
+	meter_cap.bt.max_pixelclock += 150000;
+	v4l2_find_dv_timings_cap(timings, &meter_cap, 150000, NULL, NULL);
+	return v4l2_valid_dv_timings(timings, &lt8619c_cap, NULL, NULL) ? 0 : -ERANGE;
+}
+
+static int lt8619c_query_dv_timings(struct v4l2_subdev *sd, unsigned int pad,
+				    struct v4l2_dv_timings *timings)
+{
+	struct lt8619c *lt = to_lt(sd);
+
+	guard(mutex)(&lt->lock);
+	return lt8619c_detect(lt, timings);
+}
+
+static int lt8619c_set_timings(struct v4l2_subdev *sd, unsigned int pad,
+			       struct v4l2_dv_timings *timings)
+{
+	struct lt8619c *lt = to_lt(sd);
+
+	if (!v4l2_valid_dv_timings(timings, &lt8619c_cap, NULL, NULL))
+		return -ERANGE;
+	guard(mutex)(&lt->lock);
+	if (lt->streaming)
+		return -EBUSY;
+	lt->timings = *timings;
+	return 0;
+}
+
+static int lt8619c_get_timings(struct v4l2_subdev *sd, unsigned int pad,
+			       struct v4l2_dv_timings *timings)
+{
+	struct lt8619c *lt = to_lt(sd);
+
+	guard(mutex)(&lt->lock);
+	*timings = lt->timings;
+	return 0;
+}
+
+static int lt8619c_timings_cap(struct v4l2_subdev *sd, struct v4l2_dv_timings_cap *cap)
+{
+	if (cap->pad)
+		return -EINVAL;
+	*cap = lt8619c_cap;
+	return 0;
+}
+
+static int lt8619c_enum_timings(struct v4l2_subdev *sd, struct v4l2_enum_dv_timings *e)
+{
+	return v4l2_enum_dv_timings_cap(e, &lt8619c_cap, NULL, NULL);
+}
+
+static int lt8619c_enum_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_UYVY8_2X8;
+	return 0;
+}
+
+static int lt8619c_get_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			   struct v4l2_subdev_format *fmt)
+{
+	struct lt8619c *lt = to_lt(sd);
+
+	guard(mutex)(&lt->lock);
+	fmt->format = (struct v4l2_mbus_framefmt) {
+		.width = lt->timings.bt.width,
+		.height = lt->timings.bt.height,
+		.code = MEDIA_BUS_FMT_UYVY8_2X8,
+		.field = V4L2_FIELD_NONE,
+		.colorspace = lt->timings.bt.height > 576 ?
+			V4L2_COLORSPACE_REC709 : V4L2_COLORSPACE_SMPTE170M,
+	};
+	return 0;
+}
+
+static int lt8619c_config_tx(struct lt8619c *lt, const struct v4l2_bt_timings *bt)
+{
+	u8 tx[12];
+	unsigned int val, csc;
+	int ret;
+
+	/* Copy RX dimensions to the BT encoder in pixels, before serialization. */
+	put_unaligned_be16(bt->hsync + bt->hbackporch, tx);
+	put_unaligned_be16(bt->width, tx + 2);
+	put_unaligned_be16(V4L2_DV_BT_FRAME_WIDTH(bt), tx + 4);
+	tx[6] = bt->vsync + bt->vbackporch;
+	tx[7] = V4L2_DV_BT_BLANKING_HEIGHT(bt);
+	put_unaligned_be16(bt->height, tx + 8);
+	put_unaligned_be16(V4L2_DV_BT_FRAME_HEIGHT(bt), tx + 10);
+	if (V4L2_DV_BT_BLANKING_HEIGHT(bt) > U8_MAX)
+		return -ERANGE;
+	ret = regmap_bulk_write(lt->map, LT_TX_TIMING, tx, sizeof(tx));
+	if (ret)
+		return ret;
+
+	/* AVI InfoFrame Y bits select RGB, 4:2:2 pass-through, or 4:4:4. */
+	ret = regmap_read(lt->map, 0x8071, &val);
+	if (ret)
+		return ret;
+	switch ((val >> 5) & 3) {
+	case 0:
+		csc = 0x0a;
+		break;
+	case 1:
+		csc = 0;
+		break;
+	case 2:
+		csc = 0x02;
+		break;
+	default:
+		return -ERANGE;
+	}
+	ret = regmap_write(lt->map, 0x6007, csc ? 0xf0 : 0x80);
+	if (ret)
+		return ret;
+	if (csc)
+		csc |= bt->height > 576 ? 0x30 : 0x10;
+	return regmap_write(lt->map, 0x6052, csc);
+}
+
+/* Re-lock the output PLL and find the middle of the passing SDR phase window. */
+static int lt8619c_start_tx(struct lt8619c *lt)
+{
+	static const struct reg_sequence reset[] = {
+		{ 0x600e, 0xfd, 50000 }, { 0x600e, 0xff, 100000 },
+		{ 0x600d, 0xfc, 50000 }, { 0x600d, 0xff, 50000 },
+	};
+	static const u8 phases[] = { 0x20, 0x28, 0x21, 0x29, 0x22,
+				     0x2a, 0x23, 0x2b, 0x24, 0x2c };
+	int i, start = -1, end = -1;
+	unsigned int val;
+	int ret;
+
+	ret = regmap_multi_reg_write(lt->map, reset, ARRAY_SIZE(reset));
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(lt->map, 0x8087, val, val & BIT(5), 5000, 300000);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(phases); i++) {
+		ret = regmap_write(lt->map, 0x60a2, phases[i]);
+		if (ret)
+			return ret;
+		msleep(50);
+		ret = regmap_read(lt->map, 0x6091, &val);
+		if (ret)
+			return ret;
+		if (val == 0x05) {
+			start = i;
+			end = i;
+			break;
+		}
+		if (val == 0x01) {
+			if (start < 0)
+				start = i;
+			end = i;
+		} else if (start >= 0) {
+			break;
+		}
+	}
+	if (start < 0)
+		return -ENOLCK;
+	ret = regmap_write(lt->map, 0x60a2, phases[(start + end) / 2]);
+	if (ret)
+		return ret;
+	return regmap_write(lt->map, LT_OUTPUT, LT_OUTPUT_ON);
+}
+
+static int lt8619c_enable(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			  u32 pad, u64 streams)
+{
+	static const struct reg_sequence reset_rx[] = {
+		{ 0x6009, 0x7f, 10000 }, { 0x6009, 0xff, 100000 },
+		{ 0x600c, 0xfb, 10000 }, { 0x600c, 0xff, 100000 },
+	};
+	struct lt8619c *lt = to_lt(sd);
+	struct v4l2_dv_timings signal;
+	int ret;
+
+	guard(mutex)(&lt->lock);
+	ret = regmap_write(lt->map, LT_OUTPUT, LT_OUTPUT_OFF);
+	if (ret)
+		return ret;
+	ret = regmap_multi_reg_write(lt->map, reset_rx, ARRAY_SIZE(reset_rx));
+	if (ret)
+		return ret;
+	ret = lt8619c_detect(lt, &signal);
+	if (ret)
+		return ret;
+	if (!v4l2_match_dv_timings(&signal, &lt->timings, 150000, false))
+		return -EPIPE;
+	ret = lt8619c_config_tx(lt, &signal.bt);
+	if (ret)
+		return ret;
+	ret = lt8619c_start_tx(lt);
+	if (!ret)
+		lt->streaming = true;
+	return ret;
+}
+
+static int lt8619c_disable(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			   u32 pad, u64 streams)
+{
+	struct lt8619c *lt = to_lt(sd);
+	int ret;
+
+	guard(mutex)(&lt->lock);
+	ret = regmap_write(lt->map, LT_OUTPUT, LT_OUTPUT_OFF);
+	if (ret)
+		dev_warn(sd->dev, "failed to turn off BT output: %d\n", ret);
+	/* Downstream DMA stops independently. Retry the gate on every start. */
+	lt->streaming = false;
+	return 0;
+}
+
+static const struct v4l2_subdev_pad_ops lt8619c_pad_ops = {
+	.get_edid = lt8619c_get_edid,
+	.set_edid = lt8619c_set_edid,
+	.query_dv_timings = lt8619c_query_dv_timings,
+	.g_dv_timings = lt8619c_get_timings,
+	.s_dv_timings = lt8619c_set_timings,
+	.dv_timings_cap = lt8619c_timings_cap,
+	.enum_dv_timings = lt8619c_enum_timings,
+	.enum_mbus_code = lt8619c_enum_code,
+	.get_fmt = lt8619c_get_fmt,
+	.set_fmt = lt8619c_get_fmt,
+	.enable_streams = lt8619c_enable,
+	.disable_streams = lt8619c_disable,
+};
+
+static const struct v4l2_subdev_ops lt8619c_ops = {
+	.pad = &lt8619c_pad_ops,
+};
+
+static int lt8619c_init_hw(struct lt8619c *lt)
+{
+	/* External crystal, internal reference, doubled BT clock, SDR on D8-D15. */
+	static const struct reg_sequence init[] = {
+		{ 0x6080, 0x08 }, { 0x6089, 0x88 }, { 0x608b, 0x90 },
+		{ LT_OUTPUT, LT_OUTPUT_OFF }, { 0x6004, 0xf2 },
+		{ 0x6096, 0x71 }, { 0x60a0, 0x51 }, { 0x60a3, 0x44 },
+		{ 0x60a2, 0x20 }, { 0x60a4, 0x10 }, { 0x606f, 0x04 },
+		{ 0x606d, 0x00 }, { 0x606e, 0x07 },
+	};
+	u8 id[3];
+	int ret;
+
+	ret = regmap_bulk_read(lt->map, LT_CHIP_ID, id, sizeof(id));
+	if (ret)
+		return ret;
+	if (get_unaligned_be24(id) != 0x1604b0)
+		return -ENODEV;
+	ret = regmap_update_bits(lt->map, 0x802c, 0x30, 0x30);
+	if (ret)
+		return ret;
+	ret = regmap_multi_reg_write(lt->map, init, ARRAY_SIZE(init));
+	if (ret)
+		return ret;
+	/* Positive sync, progressive, single-channel eight-bit BT.656 encoder. */
+	ret = regmap_update_bits(lt->map, 0x6060, 0x3f, 0x34);
+	if (ret)
+		return ret;
+	return lt8619c_write_edid(lt, lt8619c_default_edid, 1);
+}
+
+static void lt8619c_quiesce(void *data)
+{
+	struct lt8619c *lt = data;
+
+	regmap_write(lt->map, LT_OUTPUT, LT_OUTPUT_OFF);
+	regmap_update_bits(lt->map, LT_HPD, LT_HPD_ENABLE, 0);
+}
+
+static int lt8619c_probe(struct i2c_client *client)
+{
+	const struct v4l2_dv_timings preferred = V4L2_DV_BT_CEA_1920X1080P30;
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_BT656 };
+	struct device *dev = &client->dev;
+	struct fwnode_handle *fwnode;
+	struct lt8619c *lt;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!fwnode)
+		return -ENODEV;
+	ret = v4l2_fwnode_endpoint_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return ret;
+	if (ep.bus.parallel.bus_width != 8 || ep.bus.parallel.data_shift ||
+	    !(ep.bus.parallel.flags & V4L2_MBUS_PCLK_SAMPLE_RISING))
+		return dev_err_probe(dev, -EINVAL, "expected an 8-bit SDR BT.656 endpoint\n");
+
+	lt = devm_kzalloc(dev, sizeof(*lt), GFP_KERNEL);
+	if (!lt)
+		return -ENOMEM;
+	lt->map = devm_regmap_init_i2c(client, &lt8619c_regmap);
+	if (IS_ERR(lt->map))
+		return PTR_ERR(lt->map);
+	ret = devm_mutex_init(dev, &lt->lock);
+	if (ret)
+		return ret;
+	lt->timings = preferred;
+	v4l2_i2c_subdev_init(&lt->sd, client, &lt8619c_ops);
+	lt->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	lt->sd.entity.function = MEDIA_ENT_F_VID_IF_BRIDGE;
+	lt->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&lt->sd.entity, 1, &lt->pad);
+	if (ret)
+		return ret;
+	ret = v4l2_subdev_init_finalize(&lt->sd);
+	if (ret)
+		goto err_entity;
+	ret = lt8619c_init_hw(lt);
+	if (ret)
+		goto err_subdev;
+	ret = devm_add_action_or_reset(dev, lt8619c_quiesce, lt);
+	if (ret)
+		goto err_subdev;
+	ret = v4l2_async_register_subdev(&lt->sd);
+	if (!ret)
+		return 0;
+
+err_subdev:
+	v4l2_subdev_cleanup(&lt->sd);
+err_entity:
+	media_entity_cleanup(&lt->sd.entity);
+	return dev_err_probe(dev, ret, "could not initialize receiver\n");
+}
+
+static void lt8619c_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+}
+
+static const struct of_device_id lt8619c_of_match[] = {
+	{ .compatible = "lontium,lt8619c" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lt8619c_of_match);
+
+static struct i2c_driver lt8619c_driver = {
+	.driver = {
+		.name = "lt8619c",
+		.of_match_table = lt8619c_of_match,
+	},
+	.probe = lt8619c_probe,
+	.remove = lt8619c_remove,
+};
+module_i2c_driver(lt8619c_driver);
+
+MODULE_DESCRIPTION("Lontium LT8619C HDMI to eight-bit BT.656 receiver");
+MODULE_LICENSE("GPL");
