--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/sgmicro,sgm3851a.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/sgmicro,sgm3851a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SGMicro SGM3851A AMOLED power supply
+
+maintainers:
+  - POEG1726 <poeg1726@users.noreply.github.com>
+
+description:
+  GPIO controlled ELVDD, ELVSS and AVDD power supply. CTRL enables ELVDD
+  and ELVSS and accepts optional single-wire commands. EN_VO3 enables AVDD.
+
+properties:
+  compatible:
+    const: sgmicro,sgm3851a
+
+  ctrl-gpios:
+    maxItems: 1
+    description: Active-high enable and SWIRE signal.
+
+  en-vo3-gpios:
+    maxItems: 1
+    description: Active-high AVDD enable.
+
+  vin-supply:
+    description: Input supply shared by AVIN and PVIN.
+
+  sgmicro,swire-pulses:
+    description:
+      Number of rising edges for each command from Table 1 of the data
+      sheet, in transmission order. Omit to leave default output voltages
+      and use CTRL only as an enable. CTRL must be a non-sleeping GPIO
+      when this property is present.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 1
+    maxItems: 8
+    items:
+      minimum: 1
+      maximum: 57
+      not:
+        enum: [52, 53]
+
+required:
+  - compatible
+  - ctrl-gpios
+  - en-vo3-gpios
+  - vin-supply
+
+additionalProperties: false
