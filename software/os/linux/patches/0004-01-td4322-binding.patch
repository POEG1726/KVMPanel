From: Codex <noreply@openai.com>
Subject: [PATCH 1/2] dt-bindings: display: panel: describe the TD4322 module

Describe the logic and interface supplies and the external reset and TE
signals of the four-lane 1080x1920 module in the supplier reference.

Signed-off-by: Codex <noreply@openai.com>
---
 .../bindings/display/panel/synaptics,td4322.yaml   | 49 ++++++++++++++++++++++
 MAINTAINERS                                        |  5 +++
 2 files changed, 54 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/panel/synaptics,td4322.yaml b/Documentation/devicetree/bindings/display/panel/synaptics,td4322.yaml
new file mode 100644
index 000000000..db300d1f7
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/synaptics,td4322.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/synaptics,td4322.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Synaptics TD4322 1080x1920 four-lane command mode panel
+
+maintainers:
+  - POEG1726 <poeg1726g@gmail.com>
+
+description: |
+  The panel controls its bias converter. The host supplies VCI and VDDI,
+  pulses the active-low reset and receives the panel TE signal. Panel
+  brightness is set through MIPI DCS.
+
+allOf:
+  - $ref: panel-common.yaml#
+  - if:
+      not:
+        properties:
+          status:
+            const: disabled
+        required:
+          - status
+    then:
+      required:
+        - reset-gpios
+        - te-gpios
+
+properties:
+  compatible:
+    const: synaptics,td4322
+  reg:
+    maxItems: 1
+  reset-gpios: true
+  te-gpios: true
+  vci-supply:
+    description: 3.3 V panel supply
+  vddi-supply:
+    description: 1.8 V interface supply
+
+required:
+  - compatible
+  - reg
+  - vci-supply
+  - vddi-supply
+
+unevaluatedProperties: false
diff --git a/MAINTAINERS b/MAINTAINERS
index 5821d97ae..3183d26f3 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -8132,6 +8132,11 @@ S:	Maintained
 F:	Documentation/devicetree/bindings/display/panel/synaptics,r63353.yaml
 F:	drivers/gpu/drm/panel/panel-synaptics-r63353.c
 
