+static void jpeg_set_quality(struct jpegenc *c)
+{
+	int scale;
+
+	/*
+	 * Non-linear scaling factor:
+	 * [5,50] -> [1000..100], [51,100] -> [98..0]
+	 */
+	if (c->jpeg_quality < 50)
+		scale = 5000 / c->jpeg_quality;
+	else
+		scale = 200 - 2 * c->jpeg_quality;
+
+	BUILD_BUG_ON(ARRAY_SIZE(luma_q_table) != JPEG_QUANT_SIZE);
+	BUILD_BUG_ON(ARRAY_SIZE(chroma_q_table) != JPEG_QUANT_SIZE);
+	BUILD_BUG_ON(ARRAY_SIZE(c->hw_luma_qtable) != JPEG_QUANT_SIZE);
+	BUILD_BUG_ON(ARRAY_SIZE(c->hw_chroma_qtable) != JPEG_QUANT_SIZE);
+
+	jpeg_scale_quant_table(c->header + LUMA_QUANT_OFF,
+			       c->hw_luma_qtable, luma_q_table, scale);
+	jpeg_scale_quant_table(c->header + CHROMA_QUANT_OFF,
+			       c->hw_chroma_qtable, chroma_q_table, scale);
+}
+
+void cedrus_jpeg_header_assemble(struct jpegenc *c)
+{
+	memcpy(c->header, cedrus_jpeg_header, sizeof(cedrus_jpeg_header));
+
+	c->header[HEIGHT_OFF + 0] = c->height >> 8;
+	c->header[HEIGHT_OFF + 1] = c->height;
+	c->header[WIDTH_OFF + 0] = c->width >> 8;
+	c->header[WIDTH_OFF + 1] = c->width;
+
+	memcpy(c->header + HUFF_LUMA_DC_OFF, luma_dc_table, sizeof(luma_dc_table));
+	memcpy(c->header + HUFF_LUMA_AC_OFF, luma_ac_table, sizeof(luma_ac_table));
+	memcpy(c->header + HUFF_CHROMA_DC_OFF, chroma_dc_table, sizeof(chroma_dc_table));
+	memcpy(c->header + HUFF_CHROMA_AC_OFF, chroma_ac_table, sizeof(chroma_ac_table));
+
+	jpeg_set_quality(c);
+}
