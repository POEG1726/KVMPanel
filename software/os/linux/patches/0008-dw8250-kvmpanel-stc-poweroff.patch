Subject: [PATCH] serial: 8250_dw: send KVMPanel STC poweroff after device shutdown

--- a/Documentation/devicetree/bindings/serial/snps-dw-apb-uart.yaml
+++ b/Documentation/devicetree/bindings/serial/snps-dw-apb-uart.yaml
@@ -15,6 +15,12 @@
 
   - if:
       properties:
+  kvmpanel,stc-poweroff:
+    type: boolean
+    description:
+      The dedicated KVMPanel UART is connected to an always-powered STC8
+      that accepts a final power-cut frame after Linux device shutdown.
+
         compatible:
           items:
             - {}
--- a/drivers/tty/serial/8250/8250_dw.c
+++ b/drivers/tty/serial/8250/8250_dw.c
@@ -16,6 +16,7 @@
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/lockdep.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
@@ -23,6 +24,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/property.h>
+#include <linux/reboot.h>
 #include <linux/reset.h>
 #include <linux/slab.h>
 #include <linux/workqueue.h>
@@ -95,6 +97,7 @@
 	unsigned int		in_idle:1;
 
 	u8			no_int_count;
+	bool			stc_poweroff_ready;
 };
 
 static inline struct dw8250_data *to_dw8250_data(struct dw8250_port_data *data)
@@ -691,6 +694,67 @@
 	d->no_int_count = 0;
 }
 
+/*
+ * Prepare the dedicated, closed UART2 after device_shutdown(). The
+ * final callback sends the frame after syscore shutdown as well.
+ */
+static int dw8250_kvmpanel_prepare(struct sys_off_data *data)
+{
+	struct dw8250_data *dw = data->cb_data;
+	struct uart_8250_port *up = serial8250_get_port(dw->data.line);
+	struct uart_port *port = &up->port;
+	struct ktermios termios = {
+		.c_cflag = B9600 | CS8 | CLOCAL | CREAD,
+		.c_ispeed = 9600,
+		.c_ospeed = 9600,
+	};
+	int ret;
+
+	ret = pm_runtime_resume_and_get(port->dev);
+	if (ret < 0) {
+		dev_err(port->dev, "STC8 poweroff UART is unavailable: %d\n", ret);
+		return NOTIFY_DONE;
+	}
+	dw8250_set_termios(port, &termios, NULL);
+	serial_port_out(port, UART_IER, 0);
+	dw->stc_poweroff_ready = true;
+	return NOTIFY_DONE;
+}
+
+static int dw8250_kvmpanel_poweroff(struct sys_off_data *data)
+{
+	struct dw8250_data *dw = data->cb_data;
+	struct uart_8250_port *up = serial8250_get_port(dw->data.line);
+	struct uart_port *port = &up->port;
+	/* CMD_OFF_READY = 4, zero nonce and value, CRC-8/ATM = 0x75.
+	 * STC8 ignores this frame unless PID 1 armed it after cleanup.
+	 */
+	static const u8 ready[] = { 0xa5, 0x5a, 4, 0, 0, 0, 0, 0, 0, 0x75 };
+	unsigned int i;
+	int lsr, ret;
+
+	if (!dw->stc_poweroff_ready)
+		return NOTIFY_DONE;
+	for (i = 0; i < ARRAY_SIZE(ready); i++) {
+		ret = read_poll_timeout_atomic(serial_port_in, lsr, lsr & UART_LSR_THRE,
+					       50, 10000, false, port, UART_LSR);
+		if (ret)
+			goto failed;
+		serial_port_out(port, UART_TX, ready[i]);
+	}
+	ret = read_poll_timeout_atomic(serial_port_in, lsr, lsr & UART_LSR_TEMT,
+				       50, 10000, false, port, UART_LSR);
+	if (ret)
+		goto failed;
+	/* Allow the power controller to commit its record and cut the rail. */
+	mdelay(150);
+	return NOTIFY_DONE;
+
+failed:
+	dev_err(port->dev, "STC8 final poweroff transmission failed: %d\n", ret);
+	return NOTIFY_DONE;
+}
+
 static int dw8250_probe(struct platform_device *pdev)
 {
 	struct uart_8250_port uart = {}, *up = &uart;
@@ -858,6 +922,16 @@
 	pm_runtime_set_active(dev);
 	pm_runtime_enable(dev);
 
+	if (device_property_read_bool(dev, "kvmpanel,stc-poweroff")) {
+		err = devm_register_sys_off_handler(dev, SYS_OFF_MODE_POWER_OFF_PREPARE,
+						   SYS_OFF_PRIO_DEFAULT,
+						   dw8250_kvmpanel_prepare, data);
+		if (!err)
+			err = devm_register_power_off_handler(dev, dw8250_kvmpanel_poweroff, data);
+		if (err)
+			dev_warn(dev, "could not register STC8 poweroff: %d\n", err);
+	}
+
 	return 0;
 }
 
