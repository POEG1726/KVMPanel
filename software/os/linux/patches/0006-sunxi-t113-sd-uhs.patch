 	return !!(mmc_readl(host, REG_STAS) & SDXC_CARD_DATA_BUSY);
 }
 
+/**
+ * sunxi_mmc_find_sd_sample() - Select the center of the longest passing tap run.
+ * @host: D1 host with the card clock running at the rate under test.
+ * @opcode: SD tuning command.
+ */
+static int sunxi_mmc_find_sd_sample(struct sunxi_mmc_host *host, u32 opcode)
+{
+	unsigned int tap, run = 0, best = 0, best_end = 0;
+
+	for (tap = 0; tap <= SDXC_CAL_DL_MASK; tap++) {
+		mmc_writel(host, REG_SAMP_DL_REG, SDXC_CAL_DL_SW_EN | tap);
+		if (mmc_send_tuning(host->mmc, opcode, NULL)) {
+			run = 0;
+			continue;
+		}
+		if (++run > best) {
+			best = run;
+			best_end = tap;
+		}
+	}
+
+	if (best < 2)
+		return -EIO;
+
+	tap = best_end - best / 2;
+	mmc_writel(host, REG_SAMP_DL_REG, SDXC_CAL_DL_SW_EN | tap);
+	if (mmc_send_tuning(host->mmc, opcode, NULL))
+		return -EIO;
+
+	return tap;
+}
+
+/**
+ * sunxi_mmc_execute_tuning() - Calibrate D1 SD sampling at the negotiated rate.
+ * @mmc: MMC host.
+ * @opcode: Tuning command sent by the MMC core.
+ */
+static int sunxi_mmc_execute_tuning(struct mmc_host *mmc, u32 opcode)
+{
+	static const unsigned int fallback_rates[] = { 100000000, 50000000 };
+	struct sunxi_mmc_host *host = mmc_priv(mmc);
+	struct mmc_ios ios = mmc->ios;
+	unsigned int i;
+	int tap, ret;
+
+	if (!host->can_tune_sd || opcode != MMC_SEND_TUNING_BLOCK)
+		return 0;
+
+	if (host->sd_tuned_clock && host->sd_tuned_timing == ios.timing)
+		ios.clock = min(ios.clock, host->sd_tuned_clock);
+	host->sd_tuned_clock = 0;
+
+	tap = sunxi_mmc_find_sd_sample(host, opcode);
+	for (i = 0; tap < 0 && i < ARRAY_SIZE(fallback_rates); i++) {
+		if (fallback_rates[i] >= mmc->actual_clock)
+			continue;
+
+		/* The selected UHS bus mode also permits a slower card clock. */
+		ios.clock = fallback_rates[i];
+		ret = sunxi_mmc_clk_set_rate(host, &ios);
+		if (ret)
+			break;
+		tap = sunxi_mmc_find_sd_sample(host, opcode);
+	}
+
+	if (tap < 0) {
+		sunxi_mmc_clk_set_rate(host, &mmc->ios);
+		return tap;
+	}
+
+	host->sd_tuned_clock = ios.clock;
+	host->sd_tuned_rate = mmc->actual_clock;
+	host->sd_tuned_timing = ios.timing;
+	host->sd_sample = tap;
+
+	if (ios.clock < mmc->ios.clock)
+		dev_warn(mmc_dev(mmc), "SD tuning reduced clock to %u Hz\n",
+			 mmc->actual_clock);
+
+	return 0;
+}
+
