index 95d1dcd6f..5185ba1c3 100644
--- a/drivers/pinctrl/sunxi/pinctrl-sunxi.c
+++ b/drivers/pinctrl/sunxi/pinctrl-sunxi.c
@@ -15,12 +15,14 @@
 #include <linux/gpio/driver.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/irqchip/chained_irq.h>
 #include <linux/irqdomain.h>
 #include <linux/of.h>
 #include <linux/of_clk.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
+#include <linux/regulator/driver.h>
 #include <linux/slab.h>
 
 #include <linux/pinctrl/consumer.h>
@@ -693,6 +695,140 @@ static const struct pinconf_ops sunxi_pconf_ops = {
 	.pin_config_group_set	= sunxi_pconf_group_set,
 };
 
+#if IS_ENABLED(CONFIG_REGULATOR)
+#define SUNXI_D1_PF_SELECT	0x350
+#define SUNXI_D1_PF_STATUS	0x348
+#define SUNXI_D1_PF_MODE	BIT(5)
+#define SUNXI_D1_PF_3V3		BIT(0)
+
+static const unsigned int sunxi_d1_pf_voltages[] = { 1800000, 3300000 };
+
+static int sunxi_d1_pf_get_voltage_sel(struct regulator_dev *rdev)
+{
+	struct sunxi_pinctrl *pctl = rdev_get_drvdata(rdev);
+
+	/* POW_VAL reads 1 when PF is at 1.8 V. */
+	return !(readl(pctl->membase + SUNXI_D1_PF_STATUS) & SUNXI_D1_PF_MODE);
+}
+
+static void sunxi_d1_pf_set_bias(struct sunxi_pinctrl *pctl, bool high)
+{
+	unsigned long flags;
+	u32 val;
+
+	raw_spin_lock_irqsave(&pctl->lock, flags);
+	val = readl(pctl->membase + PIO_POW_MOD_SEL_REG);
+	val = high ? val & ~SUNXI_D1_PF_MODE : val | SUNXI_D1_PF_MODE;
+	writel(val, pctl->membase + PIO_POW_MOD_SEL_REG);
+
+	/* Use the explicit withstand mode while the PF mux changes supplies. */
+	val = readl(pctl->membase + PIO_POW_MOD_SEL_REG + PIO_POW_MOD_CTL_OFS);
+	writel(val | SUNXI_D1_PF_MODE,
+	       pctl->membase + PIO_POW_MOD_SEL_REG + PIO_POW_MOD_CTL_OFS);
+	raw_spin_unlock_irqrestore(&pctl->lock, flags);
+}
+
+/**
+ * sunxi_d1_pf_switch() - Change PF's IO domain with its card clock stopped.
+ * @pctl: Controller owning the PF selector and pad bias registers.
+ * @high: Select the 3.3 V source when true, and the VCC-PF pin otherwise.
+ */
+static int sunxi_d1_pf_switch(struct sunxi_pinctrl *pctl, bool high)
+{
+	unsigned long flags;
+	u32 val;
+	int ret;
+
+	/* Raise the withstand mode before the rail rises. Lower it after settling. */
+	if (high)
+		sunxi_d1_pf_set_bias(pctl, true);
+
+	raw_spin_lock_irqsave(&pctl->lock, flags);
+	val = readl(pctl->membase + SUNXI_D1_PF_SELECT);
+	val = high ? val | SUNXI_D1_PF_3V3 : val & ~SUNXI_D1_PF_3V3;
+	writel(val, pctl->membase + SUNXI_D1_PF_SELECT);
+	raw_spin_unlock_irqrestore(&pctl->lock, flags);
+
+	ret = readl_poll_timeout(pctl->membase + SUNXI_D1_PF_STATUS, val,
+				 !(val & SUNXI_D1_PF_MODE) == high, 100, 10000);
+	if (!ret && !high)
+		sunxi_d1_pf_set_bias(pctl, false);
+
+	return ret;
+}
+
+static int sunxi_d1_pf_set_voltage_sel(struct regulator_dev *rdev, unsigned int sel)
+{
+	struct sunxi_pinctrl *pctl = rdev_get_drvdata(rdev);
+	bool previous;
+	int ret;
+
+	previous = !!(readl(pctl->membase + SUNXI_D1_PF_SELECT) & SUNXI_D1_PF_3V3);
+	ret = sunxi_d1_pf_switch(pctl, sel);
+	if (ret) {
+		dev_err_ratelimited(pctl->dev, "PF voltage could not reach %u uV\n",
+				    sunxi_d1_pf_voltages[sel]);
+		if (sunxi_d1_pf_switch(pctl, previous))
+			dev_err_ratelimited(pctl->dev, "PF voltage rollback failed\n");
+	}
+
+	return ret;
+}
+
+static const struct regulator_ops sunxi_d1_pf_vqmmc_ops = {
+	.list_voltage = regulator_list_voltage_table,
+	.get_voltage_sel = sunxi_d1_pf_get_voltage_sel,
+	.set_voltage_sel = sunxi_d1_pf_set_voltage_sel,
+};
+
+static const struct regulator_desc sunxi_d1_pf_vqmmc_desc = {
+	.name = "pf-vqmmc",
+	.of_match = "pf-vqmmc",
+	.type = REGULATOR_VOLTAGE,
+	.owner = THIS_MODULE,
+	.volt_table = sunxi_d1_pf_voltages,
+	.n_voltages = ARRAY_SIZE(sunxi_d1_pf_voltages),
+	.ops = &sunxi_d1_pf_vqmmc_ops,
+};
+
+/**
+ * sunxi_d1_register_pf_vqmmc() - Register the opt-in PF signal-voltage mux.
+ * @pctl: D1 pin controller.
+ */
+static int sunxi_d1_register_pf_vqmmc(struct sunxi_pinctrl *pctl)
+{
+	struct regulator_config config = {
+		.dev = pctl->dev,
+		.driver_data = pctl,
+	};
+	struct regulator_dev *rdev;
+	struct device_node *node __free(device_node) =
+		of_get_child_by_name(pctl->dev->of_node, "pf-vqmmc");
+	bool high;
+
+	if (!of_device_is_available(node))
+		return 0;
+
+	config.of_node = node;
+	rdev = devm_regulator_register(pctl->dev, &sunxi_d1_pf_vqmmc_desc, &config);
+	if (IS_ERR(rdev))
+		return PTR_ERR(rdev);
+
+	/* The separate vcc-pf-supply pin-bank regulator still feeds the 1.8 V leg. */
+	pctl->pf_vqmmc = true;
+	high = !!(readl(pctl->membase + SUNXI_D1_PF_SELECT) & SUNXI_D1_PF_3V3);
+	sunxi_d1_pf_set_bias(pctl, high);
+
+	return 0;
+}
+
+#else
+static int sunxi_d1_register_pf_vqmmc(struct sunxi_pinctrl *pctl)
+{
+	return 0;
+}
+#endif
+
 static int sunxi_pinctrl_set_io_bias_cfg(struct sunxi_pinctrl *pctl,
 					 unsigned pin,
 					 struct regulator *supply)
@@ -717,6 +853,10 @@ static int sunxi_pinctrl_set_io_bias_cfg(struct sunxi_pinctrl *pctl,
 	pin -= pctl->desc->pin_base;
 	bank = pin / PINS_PER_BANK;
 
+	/* PF bias is changed together with the signal rail by the regulator. */
+	if (pctl->pf_vqmmc && bank == 5)
+		return 0;
+
 	switch (pctl->desc->io_bias_cfg_variant) {
 	case BIAS_VOLTAGE_GRP_CONFIG:
 		/*
@@ -1602,6 +1742,12 @@ int sunxi_pinctrl_init_with_flags(struct platform_device *pdev,
 		pctl->dat_shadow[i] = readl(pctl->membase + reg);
 	}
 
+	if (flags & SUNXI_PINCTRL_PORTF_SWITCH) {
+		ret = sunxi_d1_register_pf_vqmmc(pctl);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret, "cannot register PF VQMMC\n");
+	}
+
 	ret = sunxi_pinctrl_build_state(pdev);
 	if (ret) {
 		dev_err(&pdev->dev, "dt probe failed: %d\n", ret);
