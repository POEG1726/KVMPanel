config BR2_PACKAGE_KVMPANEL_AMP
	bool "KVMPanel C906 loopback and HiFi4 USB audio firmware"
	help
	  Build T113-i remoteproc firmware for the C906 echo, HiFi4 USB
	  microphone bridge and RPMsg diagnostics.
	  Set RISCV_CROSS_COMPILE and XTENSA_CROSS_COMPILE if the
	  default cross-compiler prefixes are not on PATH.
