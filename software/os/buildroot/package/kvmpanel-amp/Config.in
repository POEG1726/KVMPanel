config BR2_PACKAGE_KVMPANEL_AMP
	bool "KVMPanel C906 and HiFi4 echo firmware"
	help
	  Build the two T113-i remoteproc test firmwares and install them
	  with a command for testing the RPMsg endpoint on the board.
	  Set RISCV_CROSS_COMPILE and XTENSA_CROSS_COMPILE if the
	  default cross-compiler prefixes are not on PATH.
